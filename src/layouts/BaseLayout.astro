---
import "@/styles/global.css";
import BaseHead from "@/components/BaseHead.astro";
import Palette from "@/components/Palette.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ScrollProgress from "@/components/ScrollProgress.astro";
import { DEFAULT_LOCALE, t, type Locale } from "@/i18n";
import { ANALYTICS_SRC, ANALYTICS_WEBSITE_ID } from "@/config";

interface Props {
  title?: string;
  description?: string;
  /** Open Graph type forwarded to BaseHead */
  type?: "website" | "article";
  /** OG image path override, e.g. per-post generated card */
  ogImage?: string;
  /** Article publish date forwarded to BaseHead */
  publishedTime?: Date;
  /** Page locale: html lang, chrome strings and toggle state */
  locale?: Locale;
}

const { title, description, type, ogImage, publishedTime, locale = DEFAULT_LOCALE } =
  Astro.props;
const T = t(locale);
const analyticsEnabled = Boolean(ANALYTICS_SRC && ANALYTICS_WEBSITE_ID);
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead
      title={title}
      description={description}
      type={type}
      image={ogImage}
      publishedTime={publishedTime}
      locale={locale}
    />
    <script is:inline>
      // Apply stored theme before first paint to avoid a flash of wrong theme
      (() => {
        let stored = "dark";
        try {
          stored = localStorage.getItem("theme") === "light" ? "light" : "dark";
        } catch {}
        document.documentElement.dataset.theme = stored;
        const meta = document.getElementById("theme-color-meta");
        if (meta) meta.content = stored === "light" ? "#fafafa" : "#09090b";
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-zinc-900 focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:text-platform"
    >
      {T.skipToContent}
    </a>

    <Header locale={locale} />
    <ScrollProgress />

    <slot />

    <Footer locale={locale} />

    <Palette locale={locale} />

    <script is:inline>
      // Theme toggle (delegated so any [data-theme-toggle] button works)
      document.addEventListener("click", (event) => {
        const trigger = event.target.closest("[data-theme-toggle]");
        if (!trigger) return;
        const root = document.documentElement;
        const next = root.dataset.theme === "light" ? "dark" : "light";
        root.dataset.theme = next;
        const meta = document.getElementById("theme-color-meta");
        if (meta) meta.content = next === "light" ? "#fafafa" : "#09090b";
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });
    </script>

    {
      type === "article" && analyticsEnabled && (
        <script is:inline>
          // Post read tracking: one "post_read" event per post view once the
          // reader has scrolled 75% of the page, or immediately when the whole
          // post fits on screen. Posts in every locale report here; the locale
          // travels in the event data so translations can be compared. Silent
          // no-op when the tracker is missing (blocked, homelab down, off).
          (() => {
            const tracker = window.umami;
            if (!tracker || typeof tracker.track !== "function") return;

            let fired = false;
            const check = () => {
              if (fired) return;
              const max =
                document.documentElement.scrollHeight - window.innerHeight;
              if (max <= 0 || window.scrollY / max >= 0.75) {
                fired = true;
                window.removeEventListener("scroll", check);
                tracker.track("post_read", {
                  slug: window.location.pathname,
                  locale: document.documentElement.lang || "en",
                });
              }
            };
            window.addEventListener("scroll", check, { passive: true });
            check();
          })();
        </script>
      )
    }
  </body>
</html>
