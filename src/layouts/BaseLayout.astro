---
import "@/styles/global.css";
import BaseHead from "@/components/BaseHead.astro";
import Palette from "@/components/Palette.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ScrollProgress from "@/components/ScrollProgress.astro";

interface Props {
  title?: string;
  description?: string;
  /** Open Graph type forwarded to BaseHead */
  type?: "website" | "article";
}

const { title, description, type } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} type={type} />
    <script is:inline>
      // Apply stored theme before first paint to avoid a flash of wrong theme
      (() => {
        let stored = "dark";
        try {
          stored = localStorage.getItem("theme") === "light" ? "light" : "dark";
        } catch {}
        document.documentElement.dataset.theme = stored;
        const meta = document.getElementById("theme-color-meta");
        if (meta) meta.content = stored === "light" ? "#fafafa" : "#09090b";
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <!-- Film grain: barely-there texture so flat dark surfaces don't band.
         Static data-URI noise, no runtime cost, ignored by assistive tech. -->
    <div class="grain" aria-hidden="true"></div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-zinc-900 focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:text-platform"
    >
      Skip to content
    </a>

    <Header />
    <ScrollProgress />

    <slot />

    <Footer />

    <Palette />

    <script is:inline>
      // Theme toggle (delegated so any [data-theme-toggle] button works)
      document.addEventListener("click", (event) => {
        const trigger = event.target.closest("[data-theme-toggle]");
        if (!trigger) return;
        const root = document.documentElement;
        const next = root.dataset.theme === "light" ? "dark" : "light";
        root.dataset.theme = next;
        const meta = document.getElementById("theme-color-meta");
        if (meta) meta.content = next === "light" ? "#fafafa" : "#09090b";
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });

      // Stagger: children of [data-stagger] containers cascade in with a
      // per-index delay (grid and list reveals), and [data-reveal-delay]
      // elements fade in after a fixed delay (e.g. the hero terminal).
      document.querySelectorAll("[data-stagger]").forEach((container) => {
        Array.from(container.children).forEach((child, index) => {
          child.classList.add("reveal");
          child.style.transitionDelay = `${Math.min(index * 70, 420)}ms`;
        });
      });
      document.querySelectorAll("[data-reveal-delay]").forEach((el) => {
        el.classList.add("reveal");
        const ms = Number(el.getAttribute("data-reveal-delay")) || 0;
        el.style.transitionDelay = `${ms}ms`;
      });

      // Scroll-reveal: mark targets, then fade them in as they enter view
      document.querySelectorAll("[data-reveal]").forEach((el) => {
        el.classList.add("reveal");
      });
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              revealObserver.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.08 },
      );
      document.querySelectorAll(".reveal").forEach((el) => {
        revealObserver.observe(el);
      });
    </script>
  </body>
</html>
