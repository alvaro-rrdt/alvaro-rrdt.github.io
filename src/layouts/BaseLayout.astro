---
import "@/styles/global.css";
import BaseHead from "@/components/BaseHead.astro";
import Palette from "@/components/Palette.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ScrollProgress from "@/components/ScrollProgress.astro";

interface Props {
  title?: string;
  description?: string;
  /** Open Graph type forwarded to BaseHead */
  type?: "website" | "article";
  /** OG image path override, e.g. per-post generated card */
  ogImage?: string;
  /** Article publish date forwarded to BaseHead */
  publishedTime?: Date;
}

const { title, description, type, ogImage, publishedTime } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      type={type}
      image={ogImage}
      publishedTime={publishedTime}
    />
    <script is:inline>
      // Apply stored theme before first paint to avoid a flash of wrong theme
      (() => {
        let stored = "dark";
        try {
          stored = localStorage.getItem("theme") === "light" ? "light" : "dark";
        } catch {}
        document.documentElement.dataset.theme = stored;
        const meta = document.getElementById("theme-color-meta");
        if (meta) meta.content = stored === "light" ? "#fafafa" : "#09090b";
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-zinc-900 focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:text-platform"
    >
      Skip to content
    </a>

    <Header />
    <ScrollProgress />

    <slot />

    <Footer />

    <Palette />

    <script is:inline>
      // Theme toggle (delegated so any [data-theme-toggle] button works)
      document.addEventListener("click", (event) => {
        const trigger = event.target.closest("[data-theme-toggle]");
        if (!trigger) return;
        const root = document.documentElement;
        const next = root.dataset.theme === "light" ? "dark" : "light";
        root.dataset.theme = next;
        const meta = document.getElementById("theme-color-meta");
        if (meta) meta.content = next === "light" ? "#fafafa" : "#09090b";
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });
    </script>
  </body>
</html>
