---
import { SITE, SOCIALS, SOURCE_REPO_URL } from "@/config";

const year = new Date().getFullYear();
---

<!-- Contact band: oversized terminal line, the last beat of the page -->
<section
  class="no-print border-t border-zinc-800/60"
  aria-label="Contact"
>
  <div class="mx-auto max-w-5xl px-6 py-20 text-center sm:py-24">
    <p
      class="font-mono text-lg tracking-tight sm:text-3xl"
      aria-hidden="true"
    >
      <span class="text-zinc-500">$ git commit -m</span>
      <span class="font-semibold text-platform">"hire me"</span><span
        class="footer-caret"
      ></span>
    </p>
    <p class="mx-auto mt-6 max-w-md text-balance leading-relaxed text-zinc-400">
      Hiring for a platform or backend role, or curious about the homelab?
      My inbox is open.
    </p>
    <a
      href={`mailto:${SITE.email}`}
      class="mt-8 inline-flex items-center gap-2 rounded-lg bg-platform px-6 py-3.5 font-mono text-sm font-semibold text-zinc-950 transition-colors hover:bg-platform/85 active:bg-platform/75"
    >
      {SITE.email}
      <span aria-hidden="true">→</span>
    </a>
    <p class="mt-4 font-mono text-sm text-zinc-500">
      <a
        href="/contact"
        class="transition-colors hover:text-platform"
      >
        or write directly on /contact
      </a>
    </p>
  </div>
</section>

<footer class="no-print border-t border-zinc-800/60 py-10">
  <div class="mx-auto flex max-w-5xl flex-col gap-6 px-6">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">
      <div>
        <p class="font-mono text-sm text-zinc-300">&gt;_ {SITE.name}</p>
        <p class="mt-1 font-mono text-xs text-zinc-500">{SITE.jobTitle}</p>
      </div>

      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs text-zinc-500">
        <li>
          <a
            href={`mailto:${SITE.email}`}
            class="transition-colors hover:text-platform"
          >
            {SITE.email}
          </a>
        </li>
        {
          SOCIALS.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-platform"
              >
                {social.label.toLowerCase()}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/cv" class="transition-colors hover:text-platform">
            cv
          </a>
        </li>
        <li>
          <a href="/uses" class="transition-colors hover:text-platform">
            uses
          </a>
        </li>
        <li>
          <a
            href={SOURCE_REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-platform"
          >
            view source
          </a>
        </li>
      </ul>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-2 border-t border-zinc-800/60 pt-5 font-mono text-xs text-zinc-500">
      <p>© {year} {SITE.name}</p>
      <p>built with astro · static first · self hosted git</p>
    </div>
  </div>
</footer>

<style>
  /* Blinking caret after the closing "hire me" line */
  .footer-caret {
    display: inline-block;
    width: 0.55ch;
    height: 1em;
    translate: 0 0.14em;
    margin-left: 0.4ch;
    background: var(--color-platform);
    animation: footer-caret-blink 0.9s step-end infinite;
  }

  @keyframes footer-caret-blink {
    50% {
      opacity: 0;
    }
  }
</style>
