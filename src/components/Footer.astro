---
import { SITE, SOCIALS, SOURCE_REPO_URL } from "@/config";

const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-800/60 py-10">
  <div class="mx-auto flex max-w-5xl flex-col gap-6 px-6">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">
      <div>
        <p class="font-mono text-sm text-zinc-300">&gt;_ {SITE.name}</p>
        <p class="mt-1 font-mono text-xs text-zinc-600">{SITE.jobTitle}</p>
      </div>

      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs text-zinc-500">
        <li>
          <a
            href={`mailto:${SITE.email}`}
            class="transition-colors hover:text-platform"
          >
            {SITE.email}
          </a>
        </li>
        {
          SOCIALS.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-platform"
              >
                {social.label.toLowerCase()}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/cv" class="transition-colors hover:text-platform">
            cv
          </a>
        </li>
        <li>
          <a
            href={SOURCE_REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-platform"
          >
            view source
          </a>
        </li>
      </ul>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-2 border-t border-zinc-800/60 pt-5 font-mono text-xs text-zinc-600">
      <p>© {year} {SITE.name}</p>
      <p>built with astro · static first · self hosted git</p>
    </div>
  </div>
</footer>
