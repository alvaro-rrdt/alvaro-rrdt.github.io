---
import { getPosts } from "@/lib/content";
import { SITE } from "@/config";
import { DEFAULT_LOCALE, localePath, t, type Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const T = t(locale);
const home = localePath("/", locale);
const C = T.palette.cmd;
const H = T.palette.hint;

const posts =
  locale === "en"
    ? (await getPosts()).map((post) => ({
        label: post.data.title,
        hint: post.data.category,
        href: `/blog/${post.id}`,
      }))
    : [];

const commands = [
  { label: C.home, hint: H.page, href: home },
  { label: C.about, hint: H.section, href: `${home}#about` },
  { label: C.selectedWork, hint: H.section, href: `${home}#projects` },
  { label: C.writing, hint: H.page, href: "/blog" },
  { label: C.experience, hint: H.page, href: localePath("/experience", locale) },
  { label: C.security, hint: H.section, href: `${home}#security` },
  { label: C.toolbox, hint: H.section, href: `${home}#skills` },
  { label: C.cvViewer, hint: H.page, href: "/cv" },
  { label: C.uses, hint: H.page, href: "/uses" },
  { label: C.now, hint: H.page, href: "/now" },
  { label: C.contact, hint: H.page, href: "/contact" },
  {
    label: `email ${SITE.email}`,
    hint: H.contact,
    href: `mailto:${SITE.email}`,
  },
  ...posts,
];
---

<div
  id="palette"
  data-commands={JSON.stringify(commands)}
  data-no-matches={T.palette.noMatches}
  class="fixed inset-0 z-[70] hidden bg-zinc-950/70 backdrop-blur-sm"
>
  <!-- click-away layer -->
  <div class="absolute inset-0" data-palette-close aria-hidden="true"></div>

  <div
    role="dialog"
    aria-modal="true"
    aria-label={T.palette.dialogAria}
    class="relative mx-auto mt-[12vh] w-[min(92vw,34rem)] overflow-hidden rounded-xl border border-zinc-700 bg-zinc-900 shadow-2xl"
  >
    <input
      id="palette-input"
      type="text"
      role="combobox"
      aria-label={T.palette.inputAria}
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      placeholder={T.palette.placeholder}
      autocomplete="off"
      autocapitalize="none"
      enterkeyhint="go"
      spellcheck="false"
      class="w-full border-b border-zinc-800 bg-transparent px-5 py-4 font-mono text-base text-zinc-100 outline-none placeholder:text-zinc-500"
    />
    <ul
      id="palette-list"
      class="max-h-[50vh] overflow-y-auto p-2"
      role="listbox"
    ></ul>
    <p
      class="palette-hint border-t border-zinc-800 px-5 py-2 font-mono text-[11px] text-zinc-500"
    >
      {T.palette.hintLine}
    </p>
  </div>
</div>

<style>
  /* Keyboard hints mean nothing on touch: the list is tappable, say nothing */
  @media (pointer: coarse) {
    .palette-hint {
      display: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("palette");
    const COMMANDS = JSON.parse(root.dataset.commands);
    const NO_MATCHES = root.dataset.noMatches ?? "no matches";
    const input = document.getElementById("palette-input");
    const list = document.getElementById("palette-list");

    let filtered = [];
    let selected = 0;

    const open = () => {
      root.classList.remove("hidden");
      // Lock background scroll and hide it from assistive tech while open
      document.body.style.overflow = "hidden";
      const page = document.getElementById("main");
      if (page) page.inert = true;
      input.value = "";
      render("");
      input.focus();
    };

    const close = () => {
      root.classList.add("hidden");
      document.body.style.overflow = "";
      const page = document.getElementById("main");
      if (page) page.inert = false;
    };

    const render = (query) => {
      const q = query.trim().toLowerCase();
      filtered = COMMANDS.filter((command) =>
        command.label.toLowerCase().includes(q),
      ).slice(0, 9);
      selected = 0;

      list.innerHTML = "";
      if (filtered.length === 0) {
        list.innerHTML = `<li class="px-4 py-6 text-center font-mono text-sm text-zinc-500">${NO_MATCHES}</li>`;
        return;
      }

      for (const [index, command] of filtered.entries()) {
        const li = document.createElement("li");
        li.setAttribute("role", "option");
        li.id = `palette-option-${index}`;
        li.setAttribute("aria-selected", "false");
        li.className =
          "flex items-center justify-between gap-3 rounded-lg px-4 py-2.5 font-mono text-sm cursor-pointer";
        li.innerHTML = `
          <span class="text-zinc-200">${command.label}</span>
          <span class="text-xs text-zinc-500">${command.hint}</span>`;
        li.addEventListener("click", () => {
          window.location.href = command.href;
        });
        li.addEventListener("mousemove", () => select(index));
        list.appendChild(li);
      }
      paint();
    };

    const paint = () => {
      [...list.children].forEach((child, index) => {
        child.classList.toggle("bg-zinc-800", index === selected);
        child.setAttribute(
          "aria-selected",
          String(index === selected),
        );
        if (index === selected) {
          input.setAttribute("aria-activedescendant", child.id);
          child.querySelector("span").classList.add("text-platform");
        } else {
          child.querySelector("span").classList.remove("text-platform");
        }
      });
    };

    const select = (index) => {
      selected = Math.max(0, Math.min(index, filtered.length - 1));
      paint();
    };

    document.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        root.classList.contains("hidden") ? open() : close();
        return;
      }
      if (root.classList.contains("hidden")) return;

      // Keep keyboard focus inside the palette while it is open
      if (event.key === "Tab") {
        event.preventDefault();
        input.focus();
        return;
      }

      if (event.key === "Escape") close();
      if (event.key === "ArrowDown") {
        event.preventDefault();
        select(selected + 1);
      }
      if (event.key === "ArrowUp") {
        event.preventDefault();
        select(selected - 1);
      }
      if (event.key === "Enter" && filtered[selected]) {
        window.location.href = filtered[selected].href;
      }
    });

    document.addEventListener("click", (event) => {
      if (event.target.closest("[data-palette-open]")) open();
      if (event.target.closest("[data-palette-close]")) close();
    });

    input?.addEventListener("input", () => render(input.value));
  })();
</script>
