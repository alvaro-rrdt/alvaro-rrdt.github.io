---
/**
 * Shared section shell: anchor target + terminal-prompt eyebrow + heading.
 */
interface Props {
  id: string;
  /** Shell command rendered as the eyebrow, e.g. `~/projects` */
  prompt: string;
  title: string;
}

const { id, prompt, title } = Astro.props;
---

<!-- Mobile header is two rows tall, so anchored sections need more clearance -->
<section id={id} class="scroll-mt-24 py-16 sm:py-24 md:scroll-mt-20">
  <div class="mx-auto max-w-5xl px-6">
    <p class="font-mono text-sm text-zinc-500" aria-hidden="true">
      $ cat <span class="text-platform">{prompt}</span>
    </p>
    <h2 class="mt-2 text-2xl font-bold tracking-tight text-zinc-50 sm:text-3xl">
      {title}
    </h2>
    <div
      class="mt-3 h-px w-20 bg-gradient-to-r from-platform via-platform/40 to-transparent"
      aria-hidden="true"
    ></div>
    <div class="mt-12" data-reveal>
      <slot />
    </div>
  </div>
</section>
