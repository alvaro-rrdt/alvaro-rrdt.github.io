---
/**
 * Minimal section shell: anchor target + quiet eyebrow + heading.
 * Hierarchy comes from typography and spacing, not boxes or color.
 */
interface Props {
  id: string;
  /** Terminal-style path rendered as the eyebrow, e.g. `~/projects` */
  prompt: string;
  title: string;
}

const { id, prompt, title } = Astro.props;
---

<!-- Header is a single fixed 56px bar on every viewport now -->
<section id={id} class="scroll-mt-20 py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <p class="font-mono text-sm text-zinc-500" aria-hidden="true">
      {prompt}
    </p>
    <h2 class="mt-2 text-2xl font-semibold tracking-tight text-zinc-50 sm:text-3xl">
      {title}
    </h2>
    <div class="mt-10">
      <slot />
    </div>
  </div>
</section>
