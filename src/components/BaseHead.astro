---
import { SITE, SOCIALS } from "@/config";
import { alternatesFor, DEFAULT_LOCALE, t, type Locale } from "@/i18n";

interface Props {
  /** Page title, rendered as `${title} · ${SITE.name}`. Omit on the homepage. */
  title?: string;
  description?: string;
  /** OG image path relative to the site root, e.g. /og/default.png */
  image?: string;
  type?: "website" | "article";
  /** Article publish date; enriches the OG article tag set */
  publishedTime?: Date;
  /** Page locale; drives defaults, hreflang alternates and JSON-LD */
  locale?: Locale;
}

const {
  title,
  description,
  image = "/og/default.png",
  type = "website",
  publishedTime,
  locale = DEFAULT_LOCALE,
} = Astro.props;

const T = t(locale);
const localizedDescription = description ?? SITE.description[locale];

/**
 * Canonical URL is derived from Astro's `site` + `base` config (set in the
 * deploy phase) so every page emits correct absolute URLs automatically.
 */
const siteOrigin = Astro.site ?? new URL(SITE.url);
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const socialImageURL = image ? new URL(image, siteOrigin) : null;
const rssURL = new URL("/rss.xml", siteOrigin);
const pageTitle = title
  ? `${title} · ${SITE.name}`
  : `${SITE.name} · ${SITE.jobTitle[locale]}`;

/**
 * hreflang alternates, but only when every locale has an equivalent page.
 * Untranslated pages emit no alternates rather than links that would 404;
 * x-default always points at the English version.
 */
const alternates = alternatesFor(Astro.url.pathname, siteOrigin.href);
const defaultAlternate = alternates.find((a) => a.locale === DEFAULT_LOCALE);

/** JSON-LD Person schema so search engines associate the name with the role. */
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  jobTitle: T.meta.jobTitleShort,
  description: localizedDescription,
  email: `mailto:${SITE.email}`,
  url: new URL(SITE.url).href,
  sameAs: SOCIALS.map((social) => social.href),
};
---

<!-- Core meta -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />
<title>{pageTitle}</title>
<meta name="description" content={localizedDescription} />
<meta name="author" content={SITE.name} />
<meta name="theme-color" content="#09090b" id="theme-color-meta" />

<!-- Icons: dark default, light variant for light-mode tabs, apple touch,
     and a web manifest so installs look right on every platform -->
<link
  rel="icon"
  type="image/svg+xml"
  href="/favicon.svg"
  media="(prefers-color-scheme: dark)"
/>
<link
  rel="icon"
  type="image/svg+xml"
  href="/favicon-light.svg"
  media="(prefers-color-scheme: light)"
/>
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="canonical" href={canonicalURL.href} />
{
  alternates.map((alternate) => (
    <link
      rel="alternate"
      hreflang={alternate.locale}
      href={alternate.href}
    />
  ))
}
{
  defaultAlternate && (
    <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />
  )
}
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.name} · RSS`}
  href={rssURL.href}
/>

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={localizedDescription} />
{socialImageURL && <meta property="og:image" content={socialImageURL.href} />}
{
  socialImageURL && (
    <>
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta
        property="og:image:alt"
        content={`${pageTitle}: preview card for ${SITE.name}'s site`}
      />
    </>
  )
}
{
  type === "article" && publishedTime && (
    <meta
      property="article:published_time"
      content={publishedTime.toISOString()}
    />
  )
}
{
  type === "article" && (
    <meta property="article:author" content={SITE.name} />
  )
}

<!-- Twitter/X -->
<meta
  name="twitter:card"
  content={socialImageURL ? "summary_large_image" : "summary"}
/>
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={localizedDescription} />
{socialImageURL && <meta name="twitter:image" content={socialImageURL.href} />}

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
