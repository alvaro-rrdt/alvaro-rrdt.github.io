---
import { SITE, SOCIALS } from "@/config";

interface Props {
  /** Page title, rendered as `${title} · ${SITE.name}`. Omit on the homepage. */
  title?: string;
  description?: string;
  /** OG image path relative to /public. Defaults to SITE.ogImage; empty
   *  means no image meta is emitted (no broken share cards). */
  image?: string;
  type?: "website" | "article";
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  type = "website",
} = Astro.props;

/**
 * Canonical URL is derived from Astro's `site` + `base` config (set in the
 * deploy phase) so every page emits correct absolute URLs automatically.
 */
const siteOrigin = Astro.site ?? new URL(SITE.url);
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const socialImageURL = image ? new URL(image, siteOrigin) : null;
const rssURL = new URL("/rss.xml", siteOrigin);
const pageTitle = title
  ? `${title} · ${SITE.name}`
  : `${SITE.name} · ${SITE.jobTitle}`;

/** JSON-LD Person schema so search engines associate the name with the role. */
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  jobTitle: "Software Engineer",
  description: SITE.description,
  email: `mailto:${SITE.email}`,
  url: new URL(SITE.url).href,
  sameAs: SOCIALS.map((social) => social.href),
};
---

<!-- Core meta -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.name} />
<meta name="theme-color" content="#09090b" id="theme-color-meta" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalURL.href} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.name} · RSS`}
  href={rssURL.href}
/>

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{socialImageURL && <meta property="og:image" content={socialImageURL.href} />}

<!-- Twitter/X -->
<meta
  name="twitter:card"
  content={socialImageURL ? "summary_large_image" : "summary"}
/>
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{socialImageURL && <meta name="twitter:image" content={socialImageURL.href} />}

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
