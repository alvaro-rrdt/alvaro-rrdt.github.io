---
/**
 * Scroll position indicator, progressive enhancement only:
 * the links are plain anchors that work without JS; a tiny inline script
 * (well under 1 KB) adds the active-section state and the top progress bar.
 *
 * Desktop: vertical dot rail on the right edge with labels on hover.
 * Mobile: just the slim gradient progress bar pinned to the top.
 */
const stops = [
  { id: "about", label: "about" },
  { id: "projects", label: "projects" },
  { id: "writing", label: "writing" },
  { id: "experience", label: "experience" },
  { id: "certifications", label: "certs" },
  { id: "beyond", label: "beyond" },
];
---

<!-- Reading progress bar -->
<div class="fixed inset-x-0 top-0 z-50 h-[3px]" aria-hidden="true">
  <div
    id="scroll-progress"
    class="h-full w-0 bg-gradient-to-r from-platform to-security"
  ></div>
</div>

<!-- Section rail (desktop only) -->
<nav
  aria-label="Section position"
  class="fixed right-5 top-1/2 z-40 hidden -translate-y-1/2 lg:block xl:right-8"
>
  <ul class="space-y-5">
    {
      stops.map((stop) => (
        <li class="rail-item">
          <a href={`#${stop.id}`} data-stop={stop.id} class="group flex items-center justify-end gap-3 py-1">
            <span class="rail-label font-mono text-xs">{stop.label}</span>
            <span class="rail-line block h-[2px] w-4 rounded-full transition-all duration-200" />
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .rail-label {
    opacity: 0;
    transform: translateX(6px);
    color: var(--color-zinc-500);
    transition:
      opacity 0.2s,
      transform 0.2s,
      color 0.2s;
  }

  .rail-line {
    background-color: var(--color-zinc-700);
  }

  .rail-item:hover .rail-label,
  .rail-item.active .rail-label {
    opacity: 1;
    transform: none;
    color: var(--color-platform);
  }

  .rail-item.active .rail-line {
    width: 2rem;
    background-color: var(--color-platform);
  }
</style>

<script is:inline>
  (() => {
    const items = Array.from(document.querySelectorAll(".rail-item"));
    const byId = new Map();

    items.forEach((item) => {
      const link = item.querySelector("[data-stop]");
      if (link) byId.set(link.getAttribute("data-stop"), item);
    });

    const setActive = (id) => {
      for (const item of items) item.classList.remove("active");
      const target = byId.get(id);
      if (target) target.classList.add("active");
    };

    // A section counts as current while it crosses the viewport's middle band
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: "-40% 0px -55% 0px", threshold: 0 },
    );

    for (const id of byId.keys()) {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    }

    // Reading progress
    const bar = document.getElementById("scroll-progress");
    if (!bar) return;
    const root = document.documentElement;
    const paint = () => {
      const max = root.scrollHeight - root.clientHeight;
      bar.style.width = `${max > 0 ? (root.scrollTop / max) * 100 : 0}%`;
    };
    document.addEventListener(
      "scroll",
      () => requestAnimationFrame(paint),
      { passive: true },
    );
    window.addEventListener("resize", paint);
    paint();
  })();
</script>
