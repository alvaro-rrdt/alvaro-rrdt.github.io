---
import { SITE, SOCIALS } from "@/config";
import { CV_PDF_READY } from "@/data/cv";
import { DEFAULT_LOCALE, t, type Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const T = t(locale);

/** Job title split on "·" so separators can be dimmed. */
const titleParts = SITE.jobTitle[locale].split(" · ");

/**
 * One accent word in the tagline. Falls back to the plain string if the
 * word is ever absent from SITE.tagline.
 */
const accentWord = T.hero.accent;
const [beforeAccent, afterAccent] = SITE.tagline[locale].split(accentWord);
const hasAccent = afterAccent !== undefined;
---

<!-- pt clears the single fixed 56px header bar with room to breathe -->
<section id="top" class="flex min-h-dvh items-center pt-20 md:pt-16">
  <div class="mx-auto w-full max-w-5xl px-6">
    <div class="max-w-2xl">
      <p class="font-mono text-xs text-zinc-500 sm:text-sm">
        <span class="sm:hidden">{T.hero.wipShort}</span>
        <span class="hidden sm:inline">
          {T.hero.wip}
        </span>
      </p>

      <p class="mt-5 font-mono text-sm text-zinc-400">
        <span class="mr-2 text-platform" aria-hidden="true">●</span>
        {T.hero.openTo}<span class="hidden sm:inline">
          &nbsp;· {SITE.location[locale]} · {SITE.availabilityScope[locale]}</span>
      </p>

      <h1 class="mt-6 text-balance text-4xl font-semibold tracking-tight text-zinc-50 sm:text-6xl">
        {SITE.name}
      </h1>

      <!-- Stacks to one clean line per part on phones, single line sm+ -->
      <p class="mt-4 font-mono text-sm text-zinc-400 sm:text-lg">
        {
          titleParts.map((part, i) => (
            <>
              {i > 0 && (
                <span class="mx-2.5 hidden text-zinc-600 sm:inline">·</span>
              )}
              <span class="block sm:inline">{part}</span>
            </>
          ))
        }
      </p>

      <p class="mt-6 leading-relaxed text-zinc-400">
        {
          hasAccent ? (
            <>
              {beforeAccent}
              <span class="text-platform">{accentWord}</span>
              {afterAccent}
            </>
          ) : (
            SITE.tagline[locale]
          )
        }
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href="/cv"
          class="inline-flex items-center gap-2 rounded-lg bg-platform px-5 py-3 font-mono text-sm font-semibold text-zinc-950 transition-colors hover:bg-platform/85 active:bg-platform/75"
        >
          {T.hero.viewCv}
        </a>
        <a
          href={`mailto:${SITE.email}`}
          data-umami-event="email_click"
          class="rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-3 font-mono text-sm text-zinc-300 transition-colors hover:border-zinc-500 hover:text-platform active:border-zinc-400"
        >
          [email]
        </a>
        {
          CV_PDF_READY && (
            <a
              href={SITE.cvPath}
              download
              aria-label="Download CV as PDF"
              data-umami-event="cv_download"
              class="rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-3 font-mono text-sm text-zinc-300 transition-colors hover:border-zinc-500 hover:text-platform active:border-zinc-400"
            >
              ↓ pdf
            </a>
          )
        }
      </div>

      <!-- Socials stay reachable but quiet: one mono line, no button boxes -->
      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-sm">
        {
          SOCIALS.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-500 transition-colors hover:text-platform"
            >
              {social.label.toLowerCase()}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
