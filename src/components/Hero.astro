---
import { SITE, SOCIALS } from "@/config";
import { CV_PDF_READY } from "@/data/cv";

/** Job title split on "·" so separators can be dimmed. */
const titleParts = SITE.jobTitle.split(" · ");

/**
 * One accent word in the tagline. Falls back to the plain string if the
 * word is ever absent from SITE.tagline.
 */
const accentWord = "reliable";
const [beforeAccent, afterAccent] = SITE.tagline.split(accentWord);
const hasAccent = afterAccent !== undefined;
---

<!-- pt clears the single fixed 56px header bar with room to breathe -->
<section id="top" class="flex min-h-dvh items-center pt-24 md:pt-16">
  <div class="mx-auto w-full max-w-5xl px-6">
    <div class="max-w-2xl">
      <p class="font-mono text-xs text-zinc-500 sm:text-sm">
        // work in progress: this portfolio is under active development,
        content and polish land incrementally
      </p>

      <p class="mt-5 font-mono text-sm text-zinc-400">
        <span class="text-platform" aria-hidden="true">●</span>
        open to opportunities · {SITE.location} · relocation OK
      </p>

      <h1 class="mt-6 text-balance text-4xl font-semibold tracking-tight text-zinc-50 sm:text-6xl">
        {SITE.name}
      </h1>

      <p class="mt-4 font-mono text-sm text-zinc-400 sm:text-lg">
        {
          titleParts.map((part, i) => (
            <>
              {i > 0 && <span class="mx-2.5 text-zinc-600">·</span>}
              {part}
            </>
          ))
        }
      </p>

      <p class="mt-6 leading-relaxed text-zinc-400">
        {
          hasAccent ? (
            <>
              {beforeAccent}
              <span class="text-platform">{accentWord}</span>
              {afterAccent}
            </>
          ) : (
            SITE.tagline
          )
        }
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href="/cv"
          class="inline-flex items-center gap-2 rounded-lg bg-platform px-5 py-3 font-mono text-sm font-semibold text-zinc-950 transition-colors hover:bg-platform/85"
        >
          View CV
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-3 font-mono text-sm text-zinc-300 transition-colors hover:border-zinc-500 hover:text-platform"
        >
          [email]
        </a>
        {
          CV_PDF_READY && (
            <a
              href={SITE.cvPath}
              download
              aria-label="Download CV as PDF"
              class="rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-3 font-mono text-sm text-zinc-300 transition-colors hover:border-zinc-500 hover:text-platform"
            >
              ↓ pdf
            </a>
          )
        }
      </div>

      <!-- Socials stay reachable but quiet: one mono line, no button boxes -->
      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-sm">
        {
          SOCIALS.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-500 transition-colors hover:text-platform"
            >
              {social.label.toLowerCase()}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
