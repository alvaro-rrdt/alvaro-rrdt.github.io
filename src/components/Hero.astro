---
import { SITE, SOCIALS } from "@/config";
import { CV_PDF_READY } from "@/data/cv";

/** Job title split on "·" so separators can be dimmed. */
const titleParts = SITE.jobTitle.split(" · ");

/**
 * One accent word in the tagline. Falls back to the plain string if the
 * word is ever absent from SITE.tagline.
 */
const accentWord = "reliable";
const [beforeAccent, afterAccent] = SITE.tagline.split(accentWord);
const hasAccent = afterAccent !== undefined;
---

<!-- pt clears the mobile two-row header (bar + chip strip, ~93px);
     md restores the single-row 56px bar -->
<section
  id="top"
  class="relative flex min-h-dvh items-center overflow-hidden pt-24 md:pt-14"
>
  <!-- Backdrop: dot grid fading toward the fold + soft emerald glow -->
  <div
    class="dot-grid pointer-events-none absolute inset-0"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -top-48 left-1/2 size-[560px] -translate-x-1/2 rounded-full bg-platform/10 blur-[140px]"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto w-full max-w-5xl px-6">
    <div class="grid items-center gap-14 lg:grid-cols-[1.1fr_1fr]">
      <!-- Text stack: badge, name, title, tagline, CTAs -->
      <div data-stagger>
        <p
          class="inline-flex items-center gap-2.5 rounded-full border border-zinc-800 bg-zinc-900/80 px-3.5 py-1.5 font-mono text-xs text-zinc-400"
        >
          <span class="relative flex size-2" aria-hidden="true">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-platform opacity-60 motion-reduce:animate-none"
            ></span>
            <span class="relative inline-flex size-2 rounded-full bg-platform"
            ></span>
          </span>
          open to opportunities · EU · relocation OK
        </p>

        <h1
          class="mt-8 text-balance text-5xl font-bold tracking-tighter text-zinc-50 sm:text-7xl"
        >
          {SITE.name}
        </h1>

        <p class="mt-5 font-mono text-sm text-zinc-400 sm:text-xl">
          {
            titleParts.map((part, i) => (
              <>
                {i > 0 && <span class="mx-2.5 text-zinc-600">·</span>}
                <span class:list={[i === 0 ? "text-platform" : "text-zinc-400"]}>
                  {part}
                </span>
              </>
            ))
          }
        </p>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-zinc-400">
          {
            hasAccent ? (
              <>
                {beforeAccent}
                <span class="font-semibold text-platform">{accentWord}</span>
                {afterAccent}
              </>
            ) : (
              SITE.tagline
            )
          }
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href="/cv"
            class="inline-flex items-center gap-2 rounded-lg bg-platform px-5 py-3 font-mono text-sm font-semibold text-zinc-950 transition-all hover:-translate-y-0.5 hover:brightness-110"
          >
            View CV
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              fill="currentColor"
              class="size-4"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M2 3.75A.75.75 0 0 1 2.75 3h10.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 3.75ZM2 8a.75.75 0 0 1 .75-.75h10.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 8Zm0 4.25a.75.75 0 0 1 .75-.75h6.5a.75.75 0 0 1 0 1.5h-6.5a.75.75 0 0 1-.75-.75Z"
                clip-rule="evenodd"
              ></path>
            </svg>
          </a>
          <a
            href={`mailto:${SITE.email}`}
            class="rounded-lg border border-zinc-700 bg-zinc-900/80 px-4 py-3 font-mono text-sm text-zinc-300 transition-all hover:-translate-y-0.5 hover:border-platform/50 hover:text-platform"
          >
            [email]
          </a>
          {
            CV_PDF_READY && (
              <a
                href={SITE.cvPath}
                download
                aria-label="Download CV as PDF"
                class="rounded-lg border border-zinc-700 bg-zinc-900/80 px-4 py-3 font-mono text-sm text-zinc-300 transition-all hover:-translate-y-0.5 hover:border-platform/50 hover:text-platform"
              >
                ↓ pdf
              </a>
            )
          }
        </div>

        <!-- Socials stay reachable but quiet: one mono line, no button boxes -->
        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-sm">
          {
            SOCIALS.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-zinc-500 transition-colors hover:text-platform"
              >
                {social.label.toLowerCase()}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Terminal window: shows the homelab story instead of telling it -->
      <div
        class="overflow-hidden rounded-xl border border-zinc-700/60 bg-zinc-900/70 shadow-2xl shadow-black/50"
        data-reveal-delay="450"
        aria-hidden="true"
      >
        <div class="flex items-center gap-2 border-b border-zinc-800 px-4 py-3">
          <!-- Brand-token take on traffic lights: emerald, amber, zinc -->
          <span class="size-3 rounded-full bg-platform"></span>
          <span class="size-3 rounded-full bg-security"></span>
          <span class="size-3 rounded-full bg-zinc-600"></span>
          <span class="ml-3 font-mono text-xs text-zinc-500">
            alvaro@homelab: ~
          </span>
        </div>
        <div class="space-y-1.5 p-5 font-mono text-sm leading-relaxed">
          <p>
            <span class="text-platform">$</span>
            <span class="typing">whoami</span>
          </p>
          <p class="text-zinc-200">alvaro riccardi</p>
          <p class="text-zinc-500">platform engineering · security-minded</p>

          <p class="pt-3">
            <span class="text-platform">$</span> kubectl get pods -A
          </p>
          <div class="space-y-1 pt-1 text-xs leading-6 sm:text-[13px]">
            <p class="whitespace-pre text-zinc-600">NAME           READY  STATUS</p>
            <p class="whitespace-pre text-zinc-400">
              argocd-server  1/1  <span class="text-platform">Running</span>
            </p>
            <p class="whitespace-pre text-zinc-400">
              forgejo        1/1  <span class="text-platform">Running</span>
            </p>
            <p class="whitespace-pre text-zinc-400">
              uptime-kuma    1/1  <span class="text-platform">Running</span>
            </p>
          </div>

          <p class="pt-3">
            <span class="text-platform">$</span>
            <span class="caret"></span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * Pure-CSS typing effect: "whoami" is 6 characters wide.
   * Disabled globally under prefers-reduced-motion (see global.css).
   */
  .typing {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    animation: typing 1.1s steps(6, end) forwards;
  }

  .caret {
    display: inline-block;
    width: 0.55ch;
    height: 1.1em;
    translate: 0 0.18em;
    margin-left: 0.4ch;
    background: var(--color-platform);
    animation: caret-blink 0.9s step-end infinite;
  }

  @keyframes typing {
    from {
      width: 0;
    }
    to {
      width: 6ch;
    }
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }
</style>
