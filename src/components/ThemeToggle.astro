---
/**
 * Dark is the brand default. Choice persists in localStorage and applies
 * before first paint via the inline script in BaseLayout.
 */
interface Props {
  /** Accessible name, localized by the header */
  label?: string;
}

const { label = "Toggle color theme" } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label={label}
  class="rounded-md p-2 text-zinc-400 transition-colors hover:bg-zinc-900 hover:text-platform"
>
  <!-- moon: visible in light mode, clicking returns to dark -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 16 16"
    fill="currentColor"
    class="theme-icon-moon hidden size-4"
    aria-hidden="true"
  >
    <path
      d="M14.438 10.148c.19-.425-.321-.787-.748-.668a6.5 6.5 0 0 1-6.709-10.68l.068-.072a.75.75 0 0 0-.297-1.236A8 8 0 1 0 14.44 10.15Z"
    ></path>
  </svg>
  <!-- sun: visible in dark mode, clicking switches to light -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 16 16"
    fill="currentColor"
    class="theme-icon-sun size-4"
    aria-hidden="true"
  >
    <path
      d="M8 12a4 4 0 1 1 0-8 4 4 0 0 1 0 8ZM8 0a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V.75A.75.75 0 0 1 8 0Zm0 13a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 8 13ZM2.343 2.343a.75.75 0 0 1 1.061 0l1.06 1.061a.75.75 0 1 1-1.06 1.06l-1.06-1.06a.75.75 0 0 1 0-1.06Zm9.193 9.193a.75.75 0 0 1 1.06 0l1.061 1.06a.75.75 0 0 1-1.06 1.061l-1.061-1.06a.75.75 0 0 1 0-1.061ZM16 8a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 16 8ZM3 8a.75.75 0 0 1-.75.75H.75a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 3 8Zm10.657-5.657a.75.75 0 0 1 0 1.06l-1.061 1.061a.75.75 0 1 1-1.06-1.06l1.06-1.061a.75.75 0 0 1 1.061 0ZM4.464 11.536a.75.75 0 0 1 0 1.06l-1.06 1.061a.75.75 0 0 1-1.061-1.06l1.06-1.061a.75.75 0 0 1 1.061 0Z"
    ></path>
  </svg>
</button>

<style>
  :global(:root[data-theme="light"]) .theme-icon-moon {
    display: block;
  }
  :global(:root[data-theme="light"]) .theme-icon-sun {
    display: none;
  }
  :global(:root:not([data-theme="light"])) .theme-icon-moon {
    display: none;
  }
</style>
