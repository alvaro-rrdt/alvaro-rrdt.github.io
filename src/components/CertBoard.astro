---
import Section from "@/components/Section.astro";
import { CERTS } from "@/data/certs";
---

<Section id="certifications" prompt="~/certs --list" title="Certification journey">
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      CERTS.map((cert) => (
        <article class="rounded-xl border border-zinc-800 bg-zinc-900 p-5 transition-colors hover:border-zinc-600">
          <div class="flex items-baseline justify-between gap-2">
            <h3 class="font-mono text-lg font-bold text-zinc-50">
              {cert.name}
            </h3>
            <span class="font-mono text-xs text-zinc-600">{cert.issuer}</span>
          </div>

          <p class="mt-1 min-h-10 text-sm text-zinc-400">{cert.fullName}</p>

          <div class="mt-4">
            {cert.status === "earned" && (
              <span class="font-mono text-xs text-platform">✓ earned</span>
            )}

            {cert.status === "in-progress" && (
              <div>
                <div
                  class="h-1.5 overflow-hidden rounded-full bg-zinc-800"
                  role="progressbar"
                  aria-label={`${cert.name} progress`}
                  aria-valuenow={cert.progress}
                  aria-valuemin={0}
                  aria-valuemax={100}
                >
                  <div
                    class="h-full rounded-full bg-security"
                    style={`width: ${cert.progress ?? 0}%`}
                  />
                </div>
                <p class="mt-2 font-mono text-xs text-security">
                  in progress · {cert.note}
                </p>
              </div>
            )}

            {cert.status === "planned" && (
              <p class="font-mono text-xs text-zinc-500">
                □ planned · {cert.note}
              </p>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Section>
