---
/**
 * Certification board. Rendered as a partial inside the Security section
 * (no Section wrapper of its own).
 */
import { CERTS } from "@/data/certs";
---

<div class="grid gap-0 divide-y divide-zinc-800 sm:grid-cols-2 sm:gap-4 sm:divide-y-0 lg:grid-cols-4">
  {
    CERTS.map((cert) => {
      const featured = cert.status === "in-progress";
      return (
        <article
          class:list={[
            "group flex flex-col py-4 transition-colors active:bg-zinc-900 sm:block sm:rounded-xl sm:border sm:bg-zinc-900 sm:p-5 sm:py-5 sm:hover:border-zinc-500",
            featured
              ? "sm:border-platform/40 sm:col-span-2 lg:col-span-2"
              : "sm:border-zinc-700/60",
          ]}
        >
          <div class="flex items-baseline justify-between gap-2">
            <h4 class="font-mono text-lg font-bold text-zinc-50">
              {cert.url ? (
                <a
                  href={cert.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="transition-colors hover:text-platform"
                  aria-label={`${cert.name}: ${cert.fullName} (official program page)`}
                >
                  {cert.name}
                  <span class="ml-1 text-xs text-zinc-600" aria-hidden="true">
                    ↗
                  </span>
                </a>
              ) : (
                cert.name
              )}
            </h4>
            <span class="font-mono text-xs text-zinc-500">{cert.issuer}</span>
          </div>

          <p class="mt-1 min-h-10 text-sm text-zinc-400">{cert.fullName}</p>

          <div class={featured ? "mt-5" : "mt-4"}>
            {cert.status === "earned" && (
              <span class="font-mono text-xs text-platform">✓ earned</span>
            )}

            {cert.status === "in-progress" && (
              <div>
                <div
                  class="h-2 overflow-hidden rounded-full bg-zinc-800"
                  role="progressbar"
                  aria-label={`${cert.name} progress`}
                  aria-valuenow={cert.progress}
                  aria-valuemin={0}
                  aria-valuemax={100}
                >
                  <div
                    class="h-full rounded-full bg-platform"
                    style={`width: ${cert.progress ?? 0}%`}
                  />
                </div>
                <p class="mt-2.5 font-mono text-xs text-platform">
                  in progress · {cert.progress}% · {cert.note}
                </p>
              </div>
            )}

            {cert.status === "planned" && (
              <p class="font-mono text-xs text-zinc-500">
                □ planned · {cert.note}
              </p>
            )}
          </div>
        </article>
      );
    })
  }
</div>
