---
import { getPosts, readingMinutes } from "@/lib/content";
import Section from "@/components/Section.astro";
import FormattedDate from "@/components/FormattedDate.astro";

/** Latest three published posts, newest first. */
const posts = (await getPosts()).slice(0, 3);

/** One quiet chip style for every category: identity lives in the label. */
const categoryChip = "border-zinc-700 bg-zinc-900 text-zinc-400";
---

<Section id="writing" prompt="~/blog" title="Writing">
  <ul>
    {
      posts.map((post) => (
        /* Row is one big link via the stretched anchor; the chip is a
           separate target leading to the category listing. */
        <li class="group relative border-b border-zinc-800/60 py-6">
          <div class="flex items-center justify-between gap-4">
            <div>
              <h3 class="font-medium text-zinc-100 transition-colors group-hover:text-platform">
                <a href={`/blog/${post.id}`} class="after:absolute after:inset-0">
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-1 text-sm text-zinc-500">
                <FormattedDate date={post.data.pubDate} />
                {" · "}
                {readingMinutes(post.body)} min read
                {" · "}
                {post.data.description}
              </p>
            </div>
            <a
              href={`/blog/category/${post.data.category}`}
              class:list={[
                "relative z-10 shrink-0 rounded border px-2 py-0.5 font-mono text-xs underline-offset-2 hover:underline",
                categoryChip,
              ]}
            >
              {post.data.category}
            </a>
          </div>
        </li>
      ))
    }
  </ul>
  <a
    href="/blog"
    class="mt-6 inline-block font-mono text-sm text-zinc-500 transition-colors hover:text-platform"
  >
    view all posts →
  </a>
</Section>
