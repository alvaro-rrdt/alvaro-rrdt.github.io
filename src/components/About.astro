---
import Section from "@/components/Section.astro";
import { DEFAULT_LOCALE, t, type Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const T = t(locale);
---

<Section id="about" prompt="~/about" title={T.about.title}>
  <div class="grid gap-10 lg:grid-cols-[1fr_320px] lg:items-start">
    <div class="space-y-4 leading-relaxed text-zinc-400">
      <p>{T.about.p1}</p>
      <p>{T.about.p2}</p>
      <p>{T.about.p3}</p>
      <p>{T.about.p4}</p>
    </div>

    <aside
      class="p-0 font-mono text-sm sm:rounded-xl sm:border sm:border-zinc-700/60 sm:bg-zinc-900 sm:p-5"
      aria-label={T.about.title}
    >
      <p class="text-zinc-500">$ facts --brief</p>
      <ul class="mt-3 space-y-2.5">
        {
          T.about.facts.map((fact) => (
            <li class="flex gap-2 text-zinc-300">
              <span class="select-none text-zinc-600">→</span>
              {fact}
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</Section>
