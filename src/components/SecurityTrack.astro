---
import Section from "@/components/Section.astro";
import CertBoard from "@/components/CertBoard.astro";
import { SECURITY } from "@/data/security";
import { DEFAULT_LOCALE, t, type Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const T = t(locale);

const statusStyle: Record<string, { chip: string; glyph: string }> = {
  completed: {
    chip: "text-platform sm:border-platform/30 sm:bg-platform/10",
    glyph: "✓",
  },
  active: {
    chip: "text-platform sm:border-platform/30 sm:bg-platform/10",
    glyph: "●",
  },
  planned: {
    chip: "text-zinc-400 sm:border-zinc-700 sm:bg-zinc-950/50",
    glyph: "□",
  },
};

/**
 * Placeholder rows still containing TODO never render; replace the TODO
 * text in src/data/security.ts and they appear automatically.
 */
const studying = SECURITY.nowStudying.filter(
  (item) => !item.label.includes("TODO"),
);
const stats = SECURITY.stats.filter((stat) => !stat.value.includes("TODO"));
---

<Section id="security" prompt="~/security" title={T.security.title}>
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-6">
    <!-- Learning -->
    <article
      class="flex flex-col py-2 transition-colors active:bg-zinc-900 sm:rounded-xl sm:border sm:border-zinc-700/60 sm:bg-zinc-900 sm:p-6 sm:py-6 sm:hover:border-zinc-500"
    >
      <div class="flex items-baseline justify-between gap-3">
        <h3 class="font-semibold text-zinc-50">{T.security.learning}</h3>
        <a
          href={SECURITY.profileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs text-zinc-500 transition-colors hover:text-platform"
        >
          htb profile ↗
        </a>
      </div>

      <p class="mt-2 text-sm leading-relaxed text-zinc-400">
        {T.security.learningBlurb}
      </p>

      {
        studying.length > 0 && (
          <ul class="mt-4 space-y-2 font-mono text-sm">
            {studying.map((item) => (
              <li class="flex gap-2 text-zinc-300">
                <span class="select-none text-zinc-500">▸</span>
                {item.href ? (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="transition-colors hover:text-platform"
                  >
                    {item.label} ↗
                  </a>
                ) : (
                  item.label
                )}
              </li>
            ))}
          </ul>
        )
      }

      {
        SECURITY.completedModules.length > 0 && (
          <div class="mt-5 border-t border-zinc-800/60 pt-4">
            <p class="font-mono text-xs text-zinc-500">
              {T.security.modulesCompleted}
            </p>
            <ul class="mt-2.5 space-y-1.5 font-mono text-xs text-zinc-400">
              {
                SECURITY.completedModules.map((module) => (
                  <li class="flex gap-2">
                    <span class="select-none text-platform">✓</span>
                    {module}
                  </li>
                ))
              }
            </ul>
          </div>
        )
      }

      {
        stats.length > 0 && (
          <dl class="mt-auto grid grid-cols-3 gap-2 pt-6 sm:gap-3">
            {stats.map((stat) => (
              <div class="p-0 text-center sm:rounded-lg sm:border sm:border-zinc-800 sm:bg-zinc-950/60 sm:p-3">
                <dt class="order-2 font-mono text-[10px] uppercase tracking-wider text-zinc-500">
                  {stat.label}
                </dt>
                <dd class="font-mono text-lg font-bold text-zinc-50">
                  {stat.value}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </article>

    <!-- Competitive -->
    <article
      class="flex flex-col py-2 transition-colors active:bg-zinc-900 sm:rounded-xl sm:border sm:border-zinc-700/60 sm:bg-zinc-900 sm:p-6 sm:py-6 sm:hover:border-zinc-500"
    >
      <div class="flex items-baseline justify-between gap-3">
        <h3 class="font-semibold text-zinc-50">{T.security.proLabs}</h3>
        <span class="font-mono text-xs text-zinc-500">{T.security.competitive}</span>
      </div>

      <p class="mt-2 text-sm leading-relaxed text-zinc-400">
        {T.security.proLabsBlurb}
      </p>

      <ul class="mt-4 space-y-0 divide-y divide-zinc-800 sm:space-y-3 sm:divide-y-0">
        {
          SECURITY.proLabs.map((lab) => {
            const style = statusStyle[lab.status];
            return (
              <li class="flex items-center justify-between gap-3 py-3 sm:rounded-lg sm:border sm:border-zinc-800 sm:bg-zinc-950/60 sm:px-4 sm:py-3">
                <div>
                  <p class="font-mono text-sm text-zinc-100">{lab.name}</p>
                  <p class="text-xs text-zinc-500">
                    {lab.tier}
                    {lab.note ? ` · ${lab.note}` : ""}
                  </p>
                </div>
                <span
                  class:list={[
                    "shrink-0 font-mono text-xs sm:rounded sm:border sm:px-2 sm:py-0.5",
                    style.chip,
                  ]}
                >
                  {style.glyph} {T.security.status[lab.status]}
                </span>
              </li>
            );
          })
        }
      </ul>
    </article>
  </div>

  <!-- Certification journey: the second half of the security track -->
  <div class="mt-16">
    <p class="font-mono text-sm text-zinc-500" aria-hidden="true">
      ~/certs --list
    </p>
    <h3 class="mt-2 text-xl font-semibold tracking-tight text-zinc-50">
      {T.security.certJourney}
    </h3>
    <div class="mt-6">
      <CertBoard locale={locale} />
    </div>
  </div>
</Section>
