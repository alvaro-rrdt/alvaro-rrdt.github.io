---
import Section from "@/components/Section.astro";
import { SKILL_GROUPS } from "@/data/skills";
---

<Section id="skills" prompt="~/skills.json" title="Toolbox" index="08">
  <dl class="grid gap-x-14 gap-y-10 md:grid-cols-2">
    {
      SKILL_GROUPS.map((group) => (
        <div>
          <dt class="flex items-baseline gap-3 border-b border-zinc-800 pb-3 font-mono text-sm">
            <span class="text-platform">"</span>
            <span class="font-medium text-zinc-200">{group.category}</span>
            <span class="text-platform">":</span>
          </dt>
          <dd class="mt-3.5 leading-loose text-zinc-400">
            {group.skills.join(", ")}
          </dd>
        </div>
      ))
    }
  </dl>
</Section>
