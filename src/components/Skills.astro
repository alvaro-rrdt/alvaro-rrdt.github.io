---
import Section from "@/components/Section.astro";
import { DEFAULT_LOCALE, t, type Locale } from "@/i18n";
import { SKILL_GROUPS } from "@/data/skills";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const T = t(locale);
---

<Section id="skills" prompt="~/skills.json" title={T.skills.title}>
  <dl class="grid gap-x-14 gap-y-8 md:grid-cols-2">
    {
      SKILL_GROUPS.map((group) => (
        <div>
          <dt class="border-b border-zinc-800 pb-2 font-mono text-sm text-zinc-300">
            {group.category}
          </dt>
          <dd class="mt-3 text-sm leading-relaxed text-zinc-400">
            {group.skills.join(", ")}
          </dd>
        </div>
      ))
    }
  </dl>
</Section>
