---
import Section from "@/components/Section.astro";
import { SKILL_GROUPS } from "@/data/skills";
---

<Section id="skills" prompt="~/skills.json" title="Toolbox">
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      SKILL_GROUPS.map((group) => (
        <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-5 transition-colors hover:border-zinc-600">
          <h3 class="font-mono text-sm text-zinc-500">
            <span class="text-platform">"</span>
            {group.category}
            <span class="text-platform">":</span>
          </h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <li class="rounded border border-zinc-700/70 bg-zinc-950/50 px-2 py-1 font-mono text-xs text-zinc-300">
                {skill}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
