---
import { Image } from "astro:assets";

export type Track = "platform" | "security";

interface Props {
  title: string;
  description: string;
  stack: string[];
  track?: Track;
  href?: string;
  synced?: boolean;
  image?: ImageMetadata | null;
  /** False while the project body is still a "Write-up in progress" stub. */
  writeupReady?: boolean;
}

const {
  title,
  description,
  stack,
  href,
  synced = false,
  image = null,
  writeupReady = true,
} = Astro.props;
// `track` stays in the schema for content ordering; visuals are single-accent.
---

<!-- Mobile: borderless divided row (container in Projects.astro supplies the
     divide). sm+: the boxed card. -->
<article
  class="group flex flex-col py-4 transition-colors active:bg-zinc-900 sm:overflow-hidden sm:rounded-xl sm:border sm:border-zinc-700/60 sm:bg-zinc-900 sm:py-0 sm:hover:border-zinc-500"
>
  <!-- Screenshot, rendered only once one exists (frontmatter screenshot:) -->
  {
    image && (
      <div class="flex aspect-video items-center justify-center overflow-hidden rounded-lg border border-zinc-800 bg-zinc-900 sm:rounded-none sm:border-0 sm:border-b">
        <Image
          src={image}
          alt={`${title} screenshot`}
          widths={[400, 640, 960]}
          sizes="(min-width: 640px) 50vw, 100vw"
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col pt-3 sm:p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-semibold text-zinc-50">{title}</h3>
      {
        synced && (
          <span
            class="mt-0.5 shrink-0 font-mono text-[11px] text-platform sm:mt-0 sm:rounded sm:border sm:border-platform/30 sm:bg-platform/10 sm:px-1.5 sm:py-0.5"
            title="Deployed and running live in my self-hosted homelab"
          >
            ✓ live in homelab
          </span>
        )
      }
    </div>

    <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-400">
      {description}
    </p>

    <!-- Chips on sm+, plain text line on phones -->
    <ul class="mt-4 hidden flex-wrap gap-2 sm:flex" aria-label="Technologies used">
      {
        stack.map((tech) => (
          <li class="rounded border border-zinc-700/70 px-2 py-0.5 font-mono text-xs text-zinc-400">
            {tech}
          </li>
        ))
      }
    </ul>
    <p class="mt-3 font-mono text-xs text-zinc-500 sm:hidden">
      {stack.join(" · ")}
    </p>

    {
      href && writeupReady && (
        <a
          href={href}
          class="mt-4 inline-block font-mono text-sm text-platform transition-colors hover:text-platform/80"
        >
          read write-up →
        </a>
      )
    }
    {
      href && !writeupReady && (
        <span class="mt-4 inline-block font-mono text-sm text-zinc-500">
          write-up in progress
        </span>
      )
    }
  </div>
</article>
