---
import { getCollection } from "astro:content";
import Section from "@/components/Section.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Architecture from "@/components/Architecture.astro";
import { DEFAULT_LOCALE, t, type Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const T = t(locale);

/** Projects, curated order. */
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

/** Localized summary with English fallback (summary_es / summary_it). */
const summaryFor = (data: {
  summary: string;
  summary_es?: string;
  summary_it?: string;
}): string => {
  if (locale === "es" && data.summary_es) return data.summary_es;
  if (locale === "it" && data.summary_it) return data.summary_it;
  return data.summary;
};

/**
 * Screenshot lookup: drop files into src/assets/projects/ and reference
 * the file name in the project's frontmatter (`screenshot: name.png`).
 */
const screenshots = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/*.{png,jpg,jpeg,webp,avif}",
);

const imageByName = new Map<string, ImageMetadata>();
for (const [path, load] of Object.entries(screenshots)) {
  const mod = await load();
  imageByName.set(path.split("/").pop() ?? "", mod.default);
}

const resolveImage = (fileName?: string) =>
  fileName ? (imageByName.get(fileName) ?? null) : null;

/**
 * A write-up counts as ready once its body no longer carries the
 * "Write-up in progress" stub marker.
 */
const writeupReady = (body?: string) =>
  !(body ?? "").includes("Write-up in progress");
---

<Section id="projects" prompt="~/projects" title={T.projects.title}>
  <div class="grid gap-0 divide-y divide-zinc-800 sm:grid-cols-2 sm:gap-6 sm:divide-y-0">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={summaryFor(project.data)}
          stack={project.data.stack}
          track={project.data.track}
          synced={project.data.synced}
          href={`/projects/${project.id}`}
          image={resolveImage(project.data.screenshot)}
          writeupReady={writeupReady(project.body)}
          labels={{
            liveInHomelab: T.projects.liveInHomelab,
            liveInHomelabTitle: T.projects.liveInHomelabTitle,
            techAria: T.projects.techAria,
            writeupInProgress: T.projects.writeupInProgress,
            readWriteup: T.projects.readWriteup,
          }}
        />
      ))
    }
  </div>

  <!-- Homelab topology: collapsed behind a tap target on phones (saves
       ~400px of scroll and the horizontal-drag UX), auto-opened on md+
       by the inline script below. No-JS: collapsed but clickable. -->
  <details id="topology" class="group mt-14">
    <summary
      class="flex cursor-pointer select-none list-none items-baseline gap-3 [&::-webkit-details-marker]:hidden"
    >
      <span class="font-mono text-sm text-zinc-500" aria-hidden="true">
        ~/homelab/topology.svg
      </span>
      <h3 class="text-xl font-semibold tracking-tight text-zinc-50">
        {T.projects.howWired}
      </h3>
      <span
        class="ml-auto self-center font-mono text-zinc-500 transition-transform group-open:rotate-90 lg:hidden"
        aria-hidden="true"
      >
        ▸
      </span>
    </summary>
    <div class="mt-6">
      <Architecture />
    </div>
  </details>

  <script is:inline>
    // Real computers (lg+) start with the topology open; phones keep it
    // collapsed in every orientation, tablets are not a design target
    if (matchMedia("(min-width: 1024px)").matches) {
      document.getElementById("topology")?.setAttribute("open", "");
    }
  </script>
</Section>
