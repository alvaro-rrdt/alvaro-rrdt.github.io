---
import { getCollection } from "astro:content";
import Section from "@/components/Section.astro";
import ProjectCard from "@/components/ProjectCard.astro";

/** Projects, curated order. */
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

/**
 * Screenshot lookup: drop files into src/assets/projects/ and reference
 * the file name in the project's frontmatter (`screenshot: name.png`).
 */
const screenshots = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/*.{png,jpg,jpeg,webp,avif}",
);

const resolveImage = (fileName?: string) => {
  if (!fileName) return null;
  const match = Object.entries(screenshots).find(([path]) =>
    path.endsWith(`/${fileName}`),
  );
  return match ? match[1]().default : null;
};
---

<Section id="projects" prompt="~/projects" title="Selected work">
  <div class="grid gap-6 sm:grid-cols-2">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.summary}
          stack={project.data.stack}
          track={project.data.track}
          synced={project.data.synced}
          href={`/projects/${project.id}`}
          image={resolveImage(project.data.screenshot)}
        />
      ))
    }
  </div>
</Section>
