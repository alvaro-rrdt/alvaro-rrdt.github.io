---
import { getCollection } from "astro:content";
import Section from "@/components/Section.astro";

/** Roles, most recent first (order ascending). */
const roles = (
  await getCollection("experience")
).sort((a, b) => a.data.order - b.data.order);
---

<Section id="experience" prompt="~/experience.log" title="Experience">
  <ol class="relative space-y-12 border-l border-zinc-800 pl-8">
    {
      roles.map((entry) => (
        <li class="relative">
          <span
            class="absolute -left-[37px] top-1.5 size-2.5 rounded-full border-2 border-zinc-950 bg-platform"
            aria-hidden="true"
          />

          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h3 class="text-lg font-semibold text-zinc-50">
              {entry.data.company}
            </h3>
            <span class="font-mono text-sm text-zinc-500">
              {entry.data.role}
            </span>
            {entry.data.award && (
              <span class="rounded border border-security/30 bg-security/10 px-2 py-0.5 font-mono text-xs text-security">
                {entry.data.award}
              </span>
            )}
          </div>

          <p class="mt-0.5 font-mono text-xs text-zinc-500">
            {entry.data.period}
          </p>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-zinc-400">
            {entry.data.summary}
          </p>

          <a
            href={`/experience/${entry.id}`}
            class="mt-3 inline-block font-mono text-sm text-zinc-500 transition-colors hover:text-platform"
          >
            read the full story →
          </a>
        </li>
      ))
    }
  </ol>
</Section>
