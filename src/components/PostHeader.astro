---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";

interface Props {
  data: CollectionEntry<"blog">["data"];
}

const d = Astro.props.data;
const isDossier = d.category === "security";
---

<header class="mb-10">
  <p class="font-mono text-sm text-zinc-500">
    $ cat
    <a href="/blog" class="text-platform hover:underline">~/blog</a>
    <span class="text-zinc-600">/{d.category}</span>
  </p>

  <h1 class="mt-3 text-balance text-3xl font-bold tracking-tight text-zinc-50 sm:text-4xl">
    {d.title}
  </h1>

  <p class="mt-3 max-w-2xl leading-relaxed text-zinc-400">{d.description}</p>

  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-zinc-500">
    <FormattedDate date={d.pubDate} />
    {
      d.tags.map((tag) => (
        <span class="rounded border border-zinc-700/70 px-2 py-0.5 text-zinc-400">
          #{tag}
        </span>
      ))
    }
  </div>

  {
    !isDossier && (d.severity || d.timeToResolve) && (
      <div class="mt-6 flex flex-wrap items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-900 px-4 py-3 font-mono text-xs">
        <span class="text-platform">STATUS: RESOLVED</span>
        {d.severity && (
          <span class="rounded border border-zinc-600 bg-zinc-900 px-2 py-0.5 text-zinc-300">
            {d.severity}
          </span>
        )}
        {d.timeToResolve && (
          <span class="text-zinc-400">TTR {d.timeToResolve}</span>
        )}
      </div>
    )
  }

  {
    isDossier && (
      <div class="mt-6 rounded-lg border border-zinc-800 bg-zinc-900 p-4">
        <div class="grid grid-cols-2 gap-3 font-mono text-xs sm:grid-cols-4">
          <div>
            <p class="text-zinc-500">machine</p>
            <p class="mt-0.5 text-zinc-200">{d.machine ?? "TBA"}</p>
          </div>
          <div>
            <p class="text-zinc-500">difficulty</p>
            <p class="mt-0.5 text-zinc-200">{d.difficulty ?? "TBA"}</p>
          </div>
          <div>
            <p class="text-zinc-500">os</p>
            <p class="mt-0.5 text-zinc-200">{d.os ?? "TBA"}</p>
          </div>
          <div>
            <p class="text-zinc-500">category</p>
            <p class="mt-0.5 text-zinc-200">security</p>
          </div>
        </div>

        {d.techniques.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2">
            {d.techniques.map((technique) => (
              <li class="rounded border border-zinc-700 bg-zinc-900 px-2 py-0.5 text-zinc-300">
                {technique}
              </li>
            ))}
          </ul>
        )}

        {d.spoiler && (
          <p class="mt-3 rounded border border-zinc-600 bg-zinc-900 px-3 py-2 font-mono text-xs text-zinc-200">
            ⚠ SPOILERS: full solution walkthrough for a retired machine.
            Try it yourself first.
          </p>
        )}
      </div>
    )
  }
</header>
