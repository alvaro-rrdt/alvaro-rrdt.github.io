---
import Section from "@/components/Section.astro";

const interests = [
  "skiing",
  "bouldering",
  "surfing (work in progress)",
  "startups — someday",
];
---

<Section id="beyond" prompt="~/off-the-clock.md" title="Beyond the terminal">
  <div class="grid gap-10 lg:grid-cols-[1fr_320px] lg:items-start">
    <div class="space-y-4 leading-relaxed text-zinc-400">
      <p>
        Fresh graduate, Spanish &amp; Italian. I like building things and
        learning how they work — technology by trade, curiosity by default.
        Off the clock you'll find me on skis, on a bouldering wall, or in the
        water attempting to surf: enthusiastically bad at that last one, but
        the ocean doesn't grade attempts.
      </p>
      <p>
        The plan from here is simple — join strong teams, learn the ropes
        properly, and eventually build ventures of my own. Consider this site
        the public progress log.
      </p>
    </div>

    <aside
      class="rounded-xl border border-zinc-800 bg-zinc-900 p-5 font-mono text-sm"
      aria-label="Interests"
    >
      <p class="text-zinc-500">$ interests --list</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          interests.map((interest) => (
            <li class="rounded border border-zinc-700/70 bg-zinc-950/50 px-2 py-1 text-xs text-zinc-300">
              {interest}
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</Section>
