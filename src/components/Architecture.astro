<!--
  Hand-crafted inline SVG topology of the homelab. Crisp at any DPI,
  zero JS, no image assets. Single accent: emerald #34d399, everything
  else rides the zinc scale. Rendered as a partial inside the Selected
  work section (no Section wrapper of its own).
-->
<div class="topology overflow-x-auto rounded-xl border border-zinc-700/60 bg-zinc-900 p-4 sm:p-6">
  <svg
    viewBox="0 0 960 500"
    class="h-auto w-full min-w-[720px]"
    role="img"
    aria-label="Homelab topology: devices connect over a Tailscale tailnet to a k3s cluster on Hetzner provisioned by Pulumi. A Forgejo GitOps repo drives ArgoCD deployments, and workloads back up nightly to a Hetzner Storage Box."
  >
    <title>Homelab topology</title>

    <defs>
      <marker id="arrow-emerald" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="#34d399"></path>
      </marker>
      <marker id="arrow-zinc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="#71717a"></path>
      </marker>
    </defs>

    <!-- Tailnet trust boundary -->
    <rect x="196" y="64" width="600" height="372" rx="12" fill="none" stroke="#71717a" stroke-opacity="0.45" stroke-dasharray="6 6"></rect>
    <text x="214" y="90" fill="#71717a" fill-opacity="0.8" font-family="ui-monospace, Menlo, monospace" font-size="12">tailnet · tailscale mesh (wg)</text>

      <!-- Client -->
      <rect x="24" y="206" width="128" height="64" rx="8" fill="#18181b" stroke="#3f3f46"></rect>
      <text x="88" y="232" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="13">any device</text>
      <text x="88" y="250" text-anchor="middle" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">tailnet client</text>
      <line x1="152" y1="238" x2="232" y2="238" stroke="#34d399" stroke-width="1.5" marker-end="url(#arrow-emerald)"></line>
      <text x="158" y="258" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">encrypted</text>

      <!-- GitOps repo -->
      <rect x="260" y="96" width="180" height="40" rx="8" fill="#18181b" stroke="#3f3f46"></rect>
      <text x="350" y="121" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="12">gitops repo (forgejo)</text>
      <line x1="350" y1="136" x2="350" y2="204" stroke="#34d399" stroke-width="1.5" stroke-dasharray="4 4" marker-end="url(#arrow-emerald)"></line>
      <text x="360" y="176" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">watches main</text>

      <!-- k3s cluster -->
      <rect x="236" y="148" width="452" height="256" rx="10" fill="#131316" stroke="#52525b"></rect>
      <text x="252" y="174" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="13">k3s <tspan fill="#71717a" font-size="10">· single region, hetzner</tspan></text>

      <!-- ArgoCD -->
      <rect x="260" y="208" width="176" height="56" rx="8" fill="#18181b" stroke="#3f3f46"></rect>
      <text x="348" y="241" text-anchor="middle" fill="#34d399" font-family="ui-monospace, Menlo, monospace" font-size="13">ArgoCD</text>

      <line x1="436" y1="236" x2="468" y2="240" stroke="#34d399" stroke-width="1.5" marker-end="url(#arrow-emerald)"></line>
      <text x="438" y="226" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">sync ✓</text>

      <!-- Workloads -->
      <rect x="472" y="186" width="192" height="190" rx="8" fill="none" stroke="#3f3f46" stroke-dasharray="4 4"></rect>
      <text x="484" y="204" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">workloads</text>
      <rect x="488" y="214" width="160" height="34" rx="6" fill="#18181b" stroke="#3f3f46"></rect>
      <text x="568" y="236" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="12">forgejo</text>
      <rect x="488" y="264" width="160" height="34" rx="6" fill="#18181b" stroke="#3f3f46"></rect>
      <text x="568" y="286" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="12">postgres</text>
      <rect x="488" y="314" width="160" height="34" rx="6" fill="#18181b" stroke="#3f3f46"></rect>
      <text x="568" y="336" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="12">uptime-kuma</text>

      <!-- Backups -->
      <path d="M664,290 C720,290 764,246 816,240" fill="none" stroke="#71717a" stroke-width="1.5" stroke-dasharray="4 4" marker-end="url(#arrow-zinc)"></path>
      <text x="694" y="272" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">nightly restic</text>
      <rect x="820" y="210" width="122" height="58" rx="8" fill="#18181b" stroke="#3f3f46"></rect>
      <text x="881" y="234" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="12">storage box</text>
      <text x="881" y="252" text-anchor="middle" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">off-cluster</text>

      <!-- Pulumi provisioning -->
      <rect x="280" y="448" width="170" height="40" rx="8" fill="#18181b" stroke="#3f3f46"></rect>
      <text x="365" y="473" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="12">pulumi (go) iac</text>
      <line x1="365" y1="448" x2="365" y2="410" stroke="#71717a" stroke-width="1.5" stroke-dasharray="4 4" marker-end="url(#arrow-zinc)"></line>
      <text x="374" y="434" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">provisions hetzner</text>
    </svg>
  </div>
  <p class="mt-4 font-mono text-sm text-zinc-600">
    // secrets never leave the cluster unencrypted: SOPS + age, keys in the tailnet only
  </p>

<style is:global>
  /*
   * Light mode: the SVG above hardcodes dark-theme hexes (it predates the
   * theme toggle). These attribute-selector overrides remap them to the
   * light palette so the diagram reads intentional on white.
   */
  :root[data-theme="light"] .topology [fill="#18181b"] {
    fill: #ffffff;
  }
  :root[data-theme="light"] .topology [fill="#131316"] {
    fill: #f4f4f5;
  }
  :root[data-theme="light"] .topology [stroke="#3f3f46"] {
    stroke: #d4d4d8;
  }
  :root[data-theme="light"] .topology [stroke="#52525b"] {
    stroke: #a1a1aa;
  }
  :root[data-theme="light"] .topology [fill="#d4d4d8"] {
    fill: #27272a;
  }
  :root[data-theme="light"] .topology [fill="#71717a"] {
    fill: #52525b;
  }
  :root[data-theme="light"] .topology [fill="#34d399"] {
    fill: #059669;
  }
  :root[data-theme="light"] .topology [stroke="#34d399"] {
    stroke: #059669;
  }
  :root[data-theme="light"] .topology [stroke="#71717a"] {
    stroke: #a1a1aa;
  }
</style>
