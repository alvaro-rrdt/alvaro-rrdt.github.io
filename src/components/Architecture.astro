<!--
  Hand-crafted inline SVG topology of the homelab. Crisp at any DPI,
  zero JS, no image assets. Single accent: emerald #34d399, everything
  else rides the zinc scale. Rendered as a partial inside the Selected
  work section (no Section wrapper of its own).
-->
<div class="topology overflow-x-auto rounded-xl border border-zinc-700/60 bg-zinc-900 p-4 sm:p-6">
  <svg
    viewBox="0 0 960 576"
    class="h-auto w-full min-w-[720px]"
    role="img"
    aria-label="Homelab topology: devices connect over a Tailscale tailnet to a k3s cluster on Hetzner provisioned by Pulumi. A Forgejo GitOps repo drives ArgoCD deployments; workloads include forgejo, postgres, openwebui, vaultwarden, immich, filebrowser, prometheus and grafana. Syncthing syncs files between devices and the server, and backups go nightly to a Hetzner Storage Box."
  >
    <title>Homelab topology</title>

    <defs>
      <marker id="arrow-emerald" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="#34d399"></path>
      </marker>
      <marker id="arrow-zinc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="#71717a"></path>
      </marker>
    </defs>

    <!-- Tailnet trust boundary -->
    <rect x="232" y="64" width="560" height="452" rx="12" fill="none" stroke="#71717a" stroke-opacity="0.45" stroke-dasharray="6 6"></rect>
    <text x="250" y="90" fill="#71717a" fill-opacity="0.8" font-family="ui-monospace, Menlo, monospace" font-size="12">tailnet · tailscale mesh (wg)</text>

    <!-- Client -->
    <rect x="24" y="250" width="128" height="64" rx="8" fill="#18181b" stroke="#3f3f46"></rect>
    <text x="88" y="276" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="13">any device</text>
    <text x="88" y="294" text-anchor="middle" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">tailnet client</text>

    <!-- Traffic into the tailnet -->
    <line x1="152" y1="282" x2="232" y2="282" stroke="#34d399" stroke-width="1.5" marker-end="url(#arrow-emerald)"></line>
    <text x="158" y="272" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">encrypted</text>

    <!-- Syncthing mesh: host-level, P2P between devices and server -->
    <path d="M152,306 C200,360 220,440 278,494" fill="none" stroke="#34d399" stroke-width="1.5" stroke-dasharray="4 4" marker-start="url(#arrow-emerald)" marker-end="url(#arrow-emerald)"></path>
    <text x="158" y="404" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">file sync</text>
    <rect x="280" y="476" width="140" height="36" rx="8" fill="#18181b" stroke="#3f3f46"></rect>
    <text x="350" y="498" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="12">syncthing</text>

    <!-- GitOps repo -->
    <rect x="300" y="100" width="180" height="40" rx="8" fill="#18181b" stroke="#3f3f46"></rect>
    <text x="390" y="125" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="12">gitops repo · forgejo</text>
    <line x1="390" y1="140" x2="390" y2="200" stroke="#34d399" stroke-width="1.5" stroke-dasharray="4 4" marker-end="url(#arrow-emerald)"></line>
    <text x="398" y="176" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">watches main</text>

    <!-- k3s cluster -->
    <rect x="256" y="204" width="512" height="252" rx="10" fill="#131316" stroke="#52525b"></rect>
    <text x="272" y="230" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="13">k3s <tspan fill="#71717a" font-size="10">· single region, hetzner</tspan></text>

    <!-- ArgoCD -->
    <rect x="276" y="252" width="110" height="48" rx="8" fill="#18181b" stroke="#3f3f46"></rect>
    <text x="331" y="281" text-anchor="middle" fill="#34d399" font-family="ui-monospace, Menlo, monospace" font-size="13">ArgoCD</text>
    <line x1="386" y1="276" x2="414" y2="276" stroke="#34d399" stroke-width="1.5" marker-end="url(#arrow-emerald)"></line>
    <text x="386" y="264" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">sync ✓</text>

    <!-- Workloads: 2 x 4 grid -->
    <rect x="420" y="244" width="336" height="204" rx="8" fill="none" stroke="#3f3f46" stroke-dasharray="4 4"></rect>
    <text x="432" y="260" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">workloads</text>

    <rect x="432" y="270" width="152" height="34" rx="6" fill="#18181b" stroke="#3f3f46"></rect>
    <text x="508" y="291" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="12">forgejo</text>
    <rect x="596" y="270" width="152" height="34" rx="6" fill="#18181b" stroke="#3f3f46"></rect>
    <text x="672" y="291" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="12">immich</text>

    <rect x="432" y="314" width="152" height="34" rx="6" fill="#18181b" stroke="#3f3f46"></rect>
    <text x="508" y="335" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="12">postgres</text>
    <rect x="596" y="314" width="152" height="34" rx="6" fill="#18181b" stroke="#3f3f46"></rect>
    <text x="672" y="335" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="12">filebrowser</text>

    <rect x="432" y="358" width="152" height="34" rx="6" fill="#18181b" stroke="#3f3f46"></rect>
    <text x="508" y="379" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="12">openwebui</text>
    <rect x="596" y="358" width="152" height="34" rx="6" fill="#18181b" stroke="#3f3f46"></rect>
    <text x="672" y="379" text-anchor="middle" fill="#34d399" font-family="ui-monospace, Menlo, monospace" font-size="12">prometheus</text>

    <rect x="432" y="402" width="152" height="34" rx="6" fill="#18181b" stroke="#3f3f46"></rect>
    <text x="508" y="423" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="12">vaultwarden</text>
    <rect x="596" y="402" width="152" height="34" rx="6" fill="#18181b" stroke="#3f3f46"></rect>
    <text x="672" y="423" text-anchor="middle" fill="#34d399" font-family="ui-monospace, Menlo, monospace" font-size="12">grafana</text>

    <!-- Backups -->
    <path d="M768,330 C800,330 788,252 818,242" fill="none" stroke="#71717a" stroke-width="1.5" stroke-dasharray="4 4" marker-end="url(#arrow-zinc)"></path>
    <text x="776" y="296" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">nightly restic</text>
    <rect x="820" y="210" width="122" height="58" rx="8" fill="#18181b" stroke="#3f3f46"></rect>
    <text x="881" y="234" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="12">storage box</text>
    <text x="881" y="252" text-anchor="middle" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">off-cluster</text>

    <!-- Pulumi provisioning -->
    <rect x="560" y="532" width="180" height="36" rx="8" fill="#18181b" stroke="#3f3f46"></rect>
    <text x="650" y="554" text-anchor="middle" fill="#d4d4d8" font-family="ui-monospace, Menlo, monospace" font-size="12">pulumi (go) iac</text>
    <line x1="650" y1="532" x2="650" y2="462" stroke="#71717a" stroke-width="1.5" stroke-dasharray="4 4" marker-end="url(#arrow-zinc)"></line>
    <text x="658" y="500" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">provisions hetzner</text>

    <!-- Legend -->
    <line x1="24" y1="540" x2="52" y2="540" stroke="#71717a" stroke-width="1.5"></line>
    <text x="58" y="544" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">traffic</text>
    <line x1="120" y1="540" x2="148" y2="540" stroke="#34d399" stroke-width="1.5" stroke-dasharray="4 4"></line>
    <text x="154" y="544" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">gitops / sync</text>
    <line x1="252" y1="540" x2="280" y2="540" stroke="#71717a" stroke-width="1.5" stroke-dasharray="4 4"></line>
    <text x="286" y="544" fill="#71717a" font-family="ui-monospace, Menlo, monospace" font-size="10">backup / provision</text>
  </svg>
</div>
<p class="mt-4 font-mono text-sm text-zinc-600">
  // secrets never leave the cluster unencrypted: SOPS + age, keys in the tailnet only
</p>

<style is:global>
  /*
   * Light mode: the SVG above hardcodes dark-theme hexes (it predates the
   * theme toggle). These attribute-selector overrides remap them to the
   * light palette so the diagram reads intentional on white.
   */
  :root[data-theme="light"] .topology [fill="#18181b"] {
    fill: #ffffff;
  }
  :root[data-theme="light"] .topology [fill="#131316"] {
    fill: #f4f4f5;
  }
  :root[data-theme="light"] .topology [stroke="#3f3f46"] {
    stroke: #d4d4d8;
  }
  :root[data-theme="light"] .topology [stroke="#52525b"] {
    stroke: #a1a1aa;
  }
  :root[data-theme="light"] .topology [fill="#d4d4d8"] {
    fill: #27272a;
  }
  :root[data-theme="light"] .topology [fill="#71717a"] {
    fill: #52525b;
  }
  :root[data-theme="light"] .topology [fill="#34d399"] {
    fill: #059669;
  }
  :root[data-theme="light"] .topology [stroke="#34d399"] {
    stroke: #059669;
  }
  :root[data-theme="light"] .topology [stroke="#71717a"] {
    stroke: #a1a1aa;
  }
</style>
