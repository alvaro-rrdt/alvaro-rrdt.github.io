---
import { SITE } from "@/config";
import ThemeToggle from "@/components/ThemeToggle.astro";
import LanguageMenu from "@/components/LanguageMenu.astro";
import { DEFAULT_LOCALE, localePath, t, type Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const T = t(locale);

/**
 * One nav set on every page: section anchors on the locale home, pages
 * elsewhere. ./writing stays on the English blog until posts are
 * translated (the language menu covers the way back).
 */
const home = localePath("/", locale);
const navLinks = [
  { href: `${home}#about`, label: T.nav.about },
  { href: `${home}#projects`, label: T.nav.work },
  { href: "/blog", label: T.nav.writing },
  { href: localePath("/experience", locale), label: T.nav.experience },
  { href: `${home}#security`, label: T.nav.security },
];
---

<header
  class="no-print fixed inset-x-0 top-0 z-40 border-b border-zinc-800/60 bg-zinc-950/80 backdrop-blur"
>
  <nav
    class="nav-safe-area mx-auto flex h-14 max-w-5xl items-center justify-between gap-3 px-4 sm:px-6"
    aria-label={T.nav.aria}
  >
    <a
      href={`${home}#top`}
      class="shrink-0 whitespace-nowrap text-[11px] font-mono font-semibold text-zinc-100 transition-colors hover:text-platform min-[360px]:text-xs sm:text-sm"
    >
      &gt;_alvaro-riccardi<span
        class="wordmark-caret"
        aria-hidden="true"></span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-4 md:flex">
      <ul class="flex items-center gap-1 font-mono text-sm text-zinc-400">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded-md px-2.5 py-1.5 transition-colors hover:bg-zinc-900 hover:text-platform"
              >
                ./{link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Language switch: native details dropdown, endonym labels -->
      <LanguageMenu locale={locale} />

      <button
        type="button"
        data-palette-open
        class="min-h-11 rounded-md border border-zinc-800 px-2.5 py-2.5 font-mono text-xs text-zinc-500 transition-colors hover:border-zinc-600 hover:text-zinc-300"
        aria-label={T.palette.openAria}
      >
        <span class="kbd-fine">⌘K</span>
        <span class="kbd-coarse">{T.palette.search}</span>
      </button>

      <div class="flex min-h-11 items-center">
        <ThemeToggle label={T.themeToggle} />
      </div>

      <a
        href="/cv"
        class="flex min-h-11 items-center rounded-md border border-platform/40 bg-platform/10 px-3 py-2.5 font-mono text-sm text-platform transition-colors hover:bg-platform/20"
      >
        cv
      </a>
    </div>

    <!-- Mobile controls: the palette covers section jumping -->
    <div class="flex items-center gap-1 md:hidden">
      <LanguageMenu locale={locale} />
      <button
        type="button"
        data-palette-open
        class="flex min-h-11 items-center rounded-md border border-zinc-800 px-2.5 py-2.5 font-mono text-xs text-zinc-400"
        aria-label={T.palette.openAria}
      >
        <span class="kbd-fine">⌘K</span>
        <span class="kbd-coarse">{T.palette.search}</span>
      </button>
      <div class="flex min-h-11 items-center">
        <ThemeToggle label={T.themeToggle} />
      </div>
      <a
        href="/cv"
        class="flex min-h-11 items-center rounded-md border border-platform/40 bg-platform/10 px-3 py-2.5 font-mono text-sm text-platform"
      >
        cv
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  // Language menu polish: close on outside click or Escape. Without JS
  // the menu still toggles natively and every entry is a plain link.
  document.addEventListener("click", (event) => {
    document
      .querySelectorAll("details[data-lang-menu][open]")
      .forEach((menu) => {
        if (!menu.contains(event.target)) menu.removeAttribute("open");
      });
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    document
      .querySelectorAll("details[data-lang-menu][open]")
      .forEach((menu) => menu.removeAttribute("open"));
  });
</script>

<style>
  /* Notched phones in landscape: keep chrome clear of the sensor housing.
     BaseHead sets viewport-fit=cover so these insets are available. */
  @supports (padding: max(0px)) {
    .nav-safe-area {
      padding-left: max(1rem, env(safe-area-inset-left));
      padding-right: max(1.5rem, env(safe-area-inset-right));
    }
    @media (min-width: 640px) {
      .nav-safe-area {
        padding-left: max(1.5rem, env(safe-area-inset-left));
      }
    }
  }

  /* Touch devices have no command key: relabel the palette trigger */
  .kbd-coarse {
    display: none;
  }
  @media (pointer: coarse) {
    .kbd-fine {
      display: none;
    }
    .kbd-coarse {
      display: inline;
    }
  }

  /* The one signature animation: a blinking terminal cursor on the
     wordmark. Reduced-motion handling comes from the global rule that
     freezes all animations. */
  .wordmark-caret {
    display: inline-block;
    width: 0.55ch;
    height: 1em;
    translate: 0 0.14em;
    margin-left: 0.3ch;
    background: var(--color-platform);
    animation: wordmark-caret-blink 0.9s step-end infinite;
  }

  @keyframes wordmark-caret-blink {
    50% {
      opacity: 0;
    }
  }
</style>
