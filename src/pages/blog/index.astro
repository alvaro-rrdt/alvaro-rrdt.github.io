---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FormattedDate from "@/components/FormattedDate.astro";

const posts = (
  await getCollection("blog", ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const trackClass: Record<string, string> = {
  platform: "border-platform/30 bg-platform/10 text-platform",
  security: "border-security/30 bg-security/10 text-security",
  dev: "border-zinc-700 bg-zinc-900 text-zinc-400",
};
---

<BaseLayout
  title="Writing"
  description="Infrastructure war stories and security write-ups by Alvaro Riccardi — one unified feed."
>
  <main id="main" class="mx-auto max-w-3xl px-6 pt-24 pb-16">
    <p class="font-mono text-sm text-zinc-500">$ ls ~/blog</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-50">
      Writing
    </h1>
    <p class="mt-4 font-mono text-sm text-zinc-500">
      <span class="text-platform">platform</span> war stories ·
      <span class="text-security">security</span> write-ups · one feed
    </p>

    <ul class="mt-10">
      {
        posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class="group block border-b border-zinc-800/60 py-6"
            >
              <div class="flex items-start justify-between gap-4">
                <h2 class="font-semibold text-zinc-100 transition-colors group-hover:text-platform">
                  {post.data.title}
                </h2>
                <span
                  class:list={[
                    "shrink-0 rounded border px-2 py-0.5 font-mono text-xs",
                    trackClass[post.data.category],
                  ]}
                >
                  {post.data.category}
                </span>
              </div>
              <p class="mt-1.5 text-sm leading-relaxed text-zinc-500">
                {post.data.description}
              </p>
              <p class="mt-2 font-mono text-xs text-zinc-600">
                <FormattedDate date={post.data.pubDate} />
                {post.data.tags.map((tag) => ` · #${tag}`)}
              </p>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 font-mono text-sm text-zinc-600">
      // also available as <a href="/rss.xml" class="hover:text-platform">RSS</a>
    </p>
  </main>
</BaseLayout>
