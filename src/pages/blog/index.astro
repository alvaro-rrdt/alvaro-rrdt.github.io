---
import { getPosts, readingMinutes } from "@/lib/content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FormattedDate from "@/components/FormattedDate.astro";

const posts = await getPosts();

const trackClass: Record<string, string> = {
  platform: "border-platform/30 bg-platform/10 text-platform",
  security: "border-security/30 bg-security/10 text-security",
  dev: "border-zinc-700 bg-zinc-900 text-zinc-400",
};
---

<BaseLayout
  title="Writing"
  description="Infrastructure war stories and security write-ups by Alvaro Riccardi in one unified feed."
>
  <main id="main" class="mx-auto max-w-3xl px-6 pt-24 pb-16">
    <p class="font-mono text-sm text-zinc-500">$ ls ~/blog</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-50">
      Writing
    </h1>
    <p class="mt-4 font-mono text-sm text-zinc-500">
      <a
        href="/blog/category/platform"
        class="text-platform transition-colors hover:underline"
      >
        platform
      </a>{" "}
      war stories ·{" "}
      <a
        href="/blog/category/security"
        class="text-security transition-colors hover:underline"
      >
        security
      </a>{" "}
      write-ups · one feed
    </p>

    <ul class="mt-10">
      {
        posts.map((post) => (
          /* Row is one big link via the stretched anchor; the chip is a
             separate target leading to the category listing. */
          <li class="group relative border-b border-zinc-800/60 py-6">
            <div class="flex items-start justify-between gap-4">
              <h2 class="font-semibold text-zinc-100 transition-colors group-hover:text-platform">
                <a
                  href={`/blog/${post.id}`}
                  class="after:absolute after:inset-0"
                >
                  {post.data.title}
                </a>
              </h2>
              <a
                href={`/blog/category/${post.data.category}`}
                class:list={[
                  "relative z-10 shrink-0 rounded border px-2 py-0.5 font-mono text-xs underline-offset-2 hover:underline",
                  trackClass[post.data.category],
                ]}
              >
                {post.data.category}
              </a>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed text-zinc-500">
              {post.data.description}
            </p>
            <p class="mt-2 font-mono text-xs text-zinc-500">
              <FormattedDate date={post.data.pubDate} />
              {" · "}
              {readingMinutes(post.body)} min read
              {post.data.tags.map((tag) => ` · #${tag}`)}
            </p>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 font-mono text-sm text-zinc-500">
      // also available as <a href="/rss.xml" class="hover:text-platform">RSS</a>
    </p>
  </main>
</BaseLayout>
