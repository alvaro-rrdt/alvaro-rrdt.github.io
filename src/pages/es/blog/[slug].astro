---
import { getCollection, render } from "astro:content";
import { readingMinutes } from "@/lib/content";
import { SITE } from "@/config";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostHeader from "@/components/PostHeader.astro";
import { baseSlug, LANGUAGE_NAMES } from "@/i18n";

export async function getStaticPaths() {
  const dev = import.meta.env.DEV;
  const posts = (
    await getCollection(
      "blog",
      (post) =>
        post.data.locale === "es" && (dev || !post.data.draft),
    )
  ).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return posts.reverse().map((post, index) => ({
    params: { slug: baseSlug(post.id) },
    props: {
      post,
      prev: posts[index - 1] ?? null,
      next: posts[index + 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const slug = baseSlug(post.id);

/** Sibling translations of this same post (English + the other locale). */
const translations = (
  await getCollection("blog", (p) => baseSlug(p.id) === slug && p.data.locale !== "es")
).map((p) => ({
  locale: p.data.locale,
  href: p.data.locale === "en" ? `/blog/${baseSlug(p.id)}` : `/${p.data.locale}/blog/${baseSlug(p.id)}`,
}));

/** Article schema: richer search results for the writing */
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: {
    "@type": "Person",
    name: SITE.name,
    url: SITE.url,
  },
};

/** TOC entries: top-level sections plus one nesting level */
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const readMinutes = readingMinutes(post.body);
---

<BaseLayout
  locale="es"
  title={post.data.title}
  description={post.data.description}
  type="article"
  ogImage={`/og/${slug}.png`}
  publishedTime={post.data.pubDate}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <main id="main" class="mx-auto max-w-6xl px-6 pt-20 pb-16">
    <div class="xl:grid xl:grid-cols-[1fr_230px] xl:gap-14">
      <article class="mx-auto w-full max-w-[62ch] min-w-0">
        <!-- Breadcrumb: the listing itself is English-only, so it links there -->
        <p class="font-mono text-sm text-zinc-500">
          $ cat
          <a href="/blog" class="text-platform hover:underline">~/blog</a>
          <span class="text-zinc-500">/{post.data.category}</span>
          <span class="ml-3 text-zinc-500">· {readMinutes} min de lectura</span>
        </p>

        <!-- Mobile TOC -->
        {
          toc.length > 1 && (
            <details class="mt-5 rounded-lg border border-zinc-800 bg-zinc-900 xl:hidden">
              <summary class="cursor-pointer px-4 py-2.5 font-mono text-xs text-zinc-400">
                contenidos
              </summary>
              <ul class="border-t border-zinc-800 px-4 py-3 font-mono text-xs">
                {toc.map((heading) => (
                  <li
                    class:list={[
                      heading.depth === 3 ? "pl-4" : "",
                      "py-1",
                    ]}
                  >
                    <a
                      href={`#${heading.slug}`}
                      class="text-zinc-500 transition-colors hover:text-platform"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )
        }

        <div class="mt-8">
          <PostHeader data={post.data} />
        </div>

        {
          translations.length > 0 && (
            <p class="mt-4 font-mono text-xs text-zinc-500">
              también en:
              {translations.map((tr) => (
                <a
                  href={tr.href}
                  lang={tr.locale}
                  class="ml-2 text-platform hover:underline"
                >
                  {LANGUAGE_NAMES[tr.locale]}
                </a>
              ))}
            </p>
          )
        }

        <article
          class="prose prose-invert mt-8 max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-headings:scroll-mt-28 prose-a:text-platform prose-blockquote:border-l-zinc-700 prose-blockquote:text-zinc-400 prose-code:before:hidden prose-code:after:hidden prose-pre:bg-zinc-900 prose-pre:border prose-pre:border-zinc-800"
        >
          <Content />
        </article>

        <!-- Copy buttons are injected into each code block by the script below -->
        <script is:inline>
          (() => {
            const blocks = document.querySelectorAll("article pre");
            for (const pre of blocks) {
              const button = document.createElement("button");
              button.type = "button";
              button.className = "code-copy";
              button.setAttribute("aria-label", "Copy code to clipboard");
              button.textContent = "copy";

              if (!navigator.clipboard) button.hidden = true;

              button.addEventListener("click", async () => {
                await navigator.clipboard.writeText(pre.innerText);
                button.textContent = "copied ✓";
                setTimeout(() => (button.textContent = "copy"), 1600);
              });

              pre.appendChild(button);
            }
          })();
        </script>

        <!-- Prev / next -->
        <nav
          class="mt-14 grid gap-3 border-t border-zinc-800/60 pt-8 sm:grid-cols-2"
          aria-label="More posts"
        >
          {
            prev ? (
              <a
                href={`/es/blog/${baseSlug(prev.id)}`}
                class="group rounded-xl border border-zinc-700/60 bg-zinc-900 p-4 transition-colors hover:border-zinc-500"
              >
                <span class="font-mono text-xs text-zinc-500">← older</span>
                <p class="mt-1 text-sm font-medium text-zinc-200 transition-colors group-hover:text-platform">
                  {prev.data.title}
                </p>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a
                href={`/es/blog/${baseSlug(next.id)}`}
                class="group rounded-xl border border-zinc-700/60 bg-zinc-900 p-4 text-right transition-colors hover:border-zinc-500"
              >
                <span class="font-mono text-xs text-zinc-500">newer →</span>
                <p class="mt-1 text-sm font-medium text-zinc-200 transition-colors group-hover:text-platform">
                  {next.data.title}
                </p>
              </a>
            )
          }
        </nav>

        <p class="mt-10">
          <a
            href="/blog"
            class="font-mono text-sm text-zinc-500 transition-colors hover:text-platform"
          >
            ← all writing
          </a>
        </p>
      </article>

      <!-- Desktop TOC -->
      {
        toc.length > 1 && (
          <aside class="hidden xl:block">
            <nav
              aria-label="Table of contents"
              class="sticky top-28 max-h-[70vh] overflow-y-auto"
            >
              <p class="font-mono text-xs uppercase tracking-widest text-zinc-600">
                contenidos
              </p>
              <ul class="toc-list mt-4 space-y-2 border-l border-zinc-800 font-mono text-xs">
                {toc.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      data-toc-link={heading.slug}
                      class:list={[
                        "-ml-px block border-l border-transparent py-0.5 transition-colors hover:text-platform",
                        heading.depth === 3 ? "pl-7 text-zinc-600" : "pl-4 text-zinc-400",
                      ]}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>
  </main>
</BaseLayout>
