---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/config";
---

<BaseLayout>
  <!-- TODO(phase-2): replace with full homepage sections -->
  <main
    id="main"
    class="mx-auto flex min-h-dvh max-w-3xl flex-col items-center justify-center gap-6 px-6 text-center"
  >
    <p class="font-mono text-sm text-zinc-500">$ whoami</p>
    <h1 class="text-5xl font-bold tracking-tight text-zinc-50">
      {SITE.name}
    </h1>
    <p class="font-mono text-lg text-platform">{SITE.jobTitle}</p>
    <p class="max-w-xl text-balance text-zinc-400">{SITE.tagline}</p>
  </main>
</BaseLayout>
