---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import ScrollRail from "@/components/ScrollRail.astro";
import Hero from "@/components/Hero.astro";
import StatusStrip from "@/components/StatusStrip.astro";
import About from "@/components/About.astro";
import Projects from "@/components/Projects.astro";
import Architecture from "@/components/Architecture.astro";
import BlogSection from "@/components/BlogSection.astro";
import Experience from "@/components/Experience.astro";
import CertBoard from "@/components/CertBoard.astro";
import Skills from "@/components/Skills.astro";
import Beyond from "@/components/Beyond.astro";
import Footer from "@/components/Footer.astro";
---

<BaseLayout>
  <Header />
  <ScrollRail />
  <main id="main">
    <Hero />
    <StatusStrip />
    <About />
    <Projects />
    <Architecture />
    <BlogSection />
    <Experience />
    <CertBoard />
    <Skills />
    <Beyond />
  </main>
  <Footer />
</BaseLayout>
